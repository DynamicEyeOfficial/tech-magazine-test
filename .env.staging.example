# Staging app
NODE_ENV=production
HOST=0.0.0.0
PORT=8000
SITE_URL=http://YOUR_TEST_SERVER_IP
TRUST_PROXY=true

# Database. Keep SQLite for the first staging run; PostgreSQL stays available for rehearsal.
DATABASE_CLIENT=sqlite
DATABASE_PATH=data/tech_magazine.db
POSTGRES_URL=postgres://tech_magazine:change_this_staging_password@postgres:5432/tech_magazine
BACKUP_DIR=backups
SESSION_DAYS=7

# Uploads and media
MAX_UPLOAD_BYTES=20971520
MAX_IMAGE_UPLOAD_BYTES=5242880
MAX_VIDEO_UPLOAD_BYTES=52428800
MAX_AUDIO_UPLOAD_BYTES=26214400
MEDIA_STORAGE_PROVIDER=local
MEDIA_CDN_BASE_URL=
MEDIA_OPTIMIZATION_MODE=metadata
MEDIA_CACHE_CONTROL=public, max-age=31536000, immutable
MEDIA_SCAN_MODE=basic
MEDIA_SCANNER_WEBHOOK_URL=
VIDEO_STREAMING_PROVIDER=local
VIDEO_TRANSCODER_MODE=none
FFMPEG_PATH=ffmpeg
VIDEO_HLS_SEGMENT_SECONDS=6
VIDEO_LIVE_CHAT_PROVIDER=internal

# Search and discovery
SEARCH_PROVIDER=sqlite
SEARCH_INDEX_MODE=internal
OPENSEARCH_URL=
OPENSEARCH_INDEX=tech-magazine
OPENSEARCH_API_KEY=

# Redis cache and realtime fanout
CACHE_TTL_SECONDS=30
REDIS_URL=redis://redis:6379
REDIS_REST_URL=
REDIS_REST_TOKEN=
WORKER_ENABLED=true
WORKER_INTERVAL_MS=5000

# Firebase public config can stay enabled for browser/mobile testing.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_VAPID_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI assistant. Put the real key only in the private .env.staging file on the server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Automated news imports
NEWS_IMPORT_ENABLED=true
NEWS_IMPORT_ON_STARTUP=true
NEWS_IMPORT_INTERVAL_MINUTES=60
NEWS_IMPORT_TARGET_COUNT=50
NEWS_IMPORT_STATUS=source_policy

# Email remains dummy until domain email is configured.
EMAIL_PROVIDER=dummy
EMAIL_FROM=dummy@techmag.local
EMAIL_REPLY_TO=dummy@techmag.local
SENDGRID_API_KEY=
BREVO_API_KEY=
MAILCHIMP_API_KEY=
SES_REGION=us-east-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# Analytics and payments
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
SEARCH_CONSOLE_VERIFICATION=
MATOMO_URL=
MATOMO_SITE_ID=
PAYMENT_PROVIDER=none
