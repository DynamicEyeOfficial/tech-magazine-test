# Production app
NODE_ENV=production
HOST=0.0.0.0
PORT=8000
SITE_URL=https://your-domain.com
TRUST_PROXY=true

# Database and backups
DATABASE_CLIENT=sqlite
DATABASE_PATH=data/tech_magazine.db
POSTGRES_URL=
BACKUP_DIR=backups
SESSION_DAYS=7

# Uploads and media delivery
MAX_UPLOAD_BYTES=20971520
MAX_IMAGE_UPLOAD_BYTES=5242880
MAX_VIDEO_UPLOAD_BYTES=52428800
MAX_AUDIO_UPLOAD_BYTES=26214400
MEDIA_STORAGE_PROVIDER=local
MEDIA_CDN_BASE_URL=
MEDIA_OPTIMIZATION_MODE=metadata
MEDIA_CACHE_CONTROL=public, max-age=31536000, immutable
MEDIA_SCAN_MODE=basic
MEDIA_SCANNER_WEBHOOK_URL=
VIDEO_STREAMING_PROVIDER=local
VIDEO_TRANSCODER_MODE=none
FFMPEG_PATH=ffmpeg
VIDEO_HLS_SEGMENT_SECONDS=6
VIDEO_LIVE_CHAT_PROVIDER=internal

# Search and discovery
SEARCH_PROVIDER=sqlite
SEARCH_INDEX_MODE=internal
OPENSEARCH_URL=
OPENSEARCH_INDEX=tech-magazine
OPENSEARCH_API_KEY=

# Cloud media storage. Production on DigitalOcean should use digitalocean-spaces.
DO_SPACES_NAME=
DO_SPACES_REGION=nyc3
DO_SPACES_ENDPOINT=
DO_SPACES_ACCESS_KEY_ID=
DO_SPACES_SECRET_ACCESS_KEY=
DO_SPACES_CDN_BASE_URL=

# Optional alternate S3-compatible providers.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Cache and background worker
CACHE_TTL_SECONDS=30
REDIS_URL=
REDIS_REST_URL=
REDIS_REST_TOKEN=
WORKER_ENABLED=true
WORKER_INTERVAL_MS=5000

# Analytics
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
SEARCH_CONSOLE_VERIFICATION=
MATOMO_URL=
MATOMO_SITE_ID=

# Firebase web/mobile push public config
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_VAPID_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# GPT/OpenAI AI assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Automated tech news imports. Run the worker process beside the web process.
NEWS_IMPORT_ENABLED=true
NEWS_IMPORT_ON_STARTUP=false
NEWS_IMPORT_INTERVAL_MINUTES=60
NEWS_IMPORT_TARGET_COUNT=50
NEWS_IMPORT_STATUS=source_policy

# Email starts in dummy mode until domain DNS is ready
EMAIL_PROVIDER=dummy
EMAIL_FROM=dummy@techmag.local
EMAIL_REPLY_TO=dummy@techmag.local
SENDGRID_API_KEY=
BREVO_API_KEY=
MAILCHIMP_API_KEY=
SES_REGION=us-east-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# Payments intentionally disabled for now
PAYMENT_PROVIDER=none
