[Unit]
Description=Tech Magazine background worker
After=network.target tech-magazine.service

[Service]
Type=simple
WorkingDirectory=/opt/tech-magazine
EnvironmentFile=/opt/tech-magazine/.env
ExecStart=/usr/bin/node worker.js
Restart=always
RestartSec=5
User=techmag
Group=techmag
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
